{
  // Playwright E2E harness: root playwright.config.ts + test/e2e/**. Kept as
  // its own project (not folded into tsconfig.server.json's `test/**/*.ts`)
  // because `page.evaluate()` callbacks reference DOM globals (`document`,
  // `window`) which the server project's tsconfig deliberately omits — see
  // tsconfig.server.json's `exclude`. `npm run typecheck` (`tsc -b`) picks
  // this project up via tsconfig.json's `references`.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node", "@playwright/test"],
    "tsBuildInfoFile": "./node_modules/.cache/tsc/e2e.tsbuildinfo"
  },
  // src/reference/definitions.ts is included so specs can assert against the
  // CANONICAL definition text instead of copying it (CHI-325 3b). Copying is
  // exactly the drift the registry exists to remove, and a spec is just as
  // capable of drifting as a page. It is a dependency-free data module, so
  // pulling it in costs the e2e project nothing else.
  "include": ["playwright.config.ts", "test/e2e/**/*.ts", "src/reference/definitions.ts"]
}

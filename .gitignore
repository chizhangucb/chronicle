# Both forms on purpose: the trailing-slash pattern does NOT match a SYMLINK
# named node_modules, which is exactly what you create when linking deps into a
# `git worktree` (worktrees get no node_modules of their own). Without the bare
# form, `git add -A` in a worktree silently stages that symlink into a public repo.
node_modules
node_modules/
dist/
dist-server/
.DS_Store
release/
.playwright-mcp/
audit-shots/
playwright-report/
test-results/

# code-graph output from local analysis tooling; regenerated, never committed
graphify-out

# subagent-driven-development scratch workspace (ledger, briefs, reports)
.superpowers/

# Environment files with secrets (never public)
.env
.env.*
!.env.example

# Local Claude Code settings (personal hooks, never public)
.claude/settings.local.json
.claude/state/
.claude/worktrees/

# Python bytecode: a .pyc embeds the ABSOLUTE path of the source it was
# compiled from, and the guard cannot read it to notice.
__pycache__/
*.pyc

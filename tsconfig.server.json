{
  // Server + shared + tests. Node 24 ESM: nodenext resolution, `.ts` runs natively.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.cache/tsc/server.tsbuildinfo"
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "test/**/*.ts"]
}

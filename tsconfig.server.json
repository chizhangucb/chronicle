{
  // Server + shared + tests. Node 24 ESM: nodenext resolution, `.ts` runs natively.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.cache/tsc/server.tsbuildinfo"
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "test/**/*.ts"],
  // test/e2e/** is its own project (tsconfig.e2e.json) — it needs the "dom"
  // lib for page.evaluate() callbacks, which this project deliberately omits.
  "exclude": ["test/e2e/**"]
}

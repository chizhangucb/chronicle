{
  "name": "chronicle-cli",
  "version": "1.4.0",
  "description": "Local-first session manager + Insights analytics for AI coding sessions: import Claude Code, Codex, Cursor & OpenCode, replay to the exact Git snapshot, redact secrets. npx chronicle-cli, no cloud, no telemetry.",
  "bin": {
    "chronicle": "bin/chronicle.mjs",
    "chronicle-cli": "bin/chronicle.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "bin",
    "data",
    "dist",
    "dist-server",
    "launchd",
    "scripts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "standalone": "npm run build && node server/standalone.ts",
    "test": "node --import ./test/no-ambient-hub.mjs --test 'test/**/*.test.mjs'",
    "test:e2e": "playwright test",
    "walk": "node test/e2e/walk.mjs",
    "walk:seeded": "node scripts/walk-seed.mjs",
    "typecheck": "tsc -b",
    "prepack": "rm -rf dist-server && npm run build && tsc -p tsconfig.publish.json",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "ai",
    "sessions",
    "cost",
    "tokens",
    "local-first",
    "cli"
  ],
  "author": "Chi Zhang",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chizhangucb/chronicle.git"
  },
  "homepage": "https://getchronicle.dev",
  "bugs": {
    "url": "https://github.com/chizhangucb/chronicle/issues"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-toast": "^1.2.23",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.3",
    "diff": "^9.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.10.1",
    "typescript": "5.9.3",
    "vite": "^8.1.3",
    "wouter": "^3.10.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "js-yaml": "^4.3.1"
  }
}

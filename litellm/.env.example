# Copy to litellm/.env (gitignored) and fill in, or export these yourself.
# run.sh sources $LITELLM_ENV_FILE, defaulting to litellm/.env.

# Upstream key for every openrouter/* route. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Gates the loopback endpoint. Any long random string you also give clients:
#   LITELLM_MASTER_KEY="sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=

# Optional. Only needed for the direct anthropic/* route.
# ANTHROPIC_API_KEY=

# Optional. Where spend rows land. Default: <CHRONICLE_DATA_DIR or ~/.chronicle>/litellm/spend.jsonl,
# which is exactly where Chronicle's Spend tab reads them from.
# LANE_C_SPEND_LOG=

# Optional bind override. Default 127.0.0.1:4000 (loopback only; see config.yaml).
# LITELLM_HOST=127.0.0.1
# LITELLM_PORT=4000

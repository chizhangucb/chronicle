<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LiteLLM spine (Lane C): the loopback metered routing proxy on 127.0.0.1:4000.
  Chronicle reads the spend log it writes (server/laneC.ts), so the job lives here.
  KeepAlive: launchd restarts it if it dies. Install with `node scripts/install-jobs.mjs`
  (fills __REPO__ / __DATA__), --bootstrap to also load it.
  Keys: run.sh sources $LITELLM_ENV_FILE, default litellm/.env in the repo. Copy
  litellm/.env.example there first; without keys run.sh exits 78 naming what is
  missing, so install-jobs.mjs declines to bootstrap this one until it is
  configured (KeepAlive would otherwise respawn it forever). ThrottleInterval
  keeps even a misconfigured restart cheap.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chronicle.litellm</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__REPO__/litellm/run.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- Pin the data dir the installer resolved, so the spend log the proxy
         writes is the one Chronicle's Spend tab reads (issue #186). Override a
         path or a key in litellm/.env; run.sh sources it. -->
    <key>CHRONICLE_DATA_DIR</key>
    <string>__DATA__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>__DATA__/logs/litellm.log</string>
  <key>StandardErrorPath</key>
  <string>__DATA__/logs/litellm.err.log</string>
</dict>
</plist>

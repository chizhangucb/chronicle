<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Chronicle daily-briefing job template (CHI-323 3c). Ships DORMANT: it is NOT
  auto-installed, so it never runs a second daily briefing alongside another
  console's. Install it yourself with `node scripts/install-jobs.mjs` (fills the
  __PLACEHOLDERS__ and symlinks into ~/Library/LaunchAgents). The briefing runner
  it points at (scripts/run-briefing.ts) lands with the Briefing organ.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chronicle.briefing</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/scripts/run-briefing.ts</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__DATA__/logs/briefing.log</string>
  <key>StandardErrorPath</key>
  <string>__DATA__/logs/briefing.err.log</string>
</dict>
</plist>
